{
  "engine": "proprietary-asr-v2",
  "version": "1.0",
  "capabilities": {
    "max_public_rules": 1,
    "flags": "lhs_only",
    "function_map": {"lookup": "lookup"},
    "allow_parameterized_rules": true
  },
  "lazy_loading": {
    "lookup_limit": 50,
    "expansion_limit": 5000
  },
  "data_sources": {
    "bank_names": { "type": "file", "path": "nonterminals/bank_names.txt" },
    "bank_name": { "type": "file", "path": "nonterminals/bank_names.txt" },
    "company_names": { "type": "file", "path": "nonterminals/company_names.txt" },
    "company_name": { "type": "file", "path": "nonterminals/company_names.txt" },
    "loan_type":   { "type": "file", "path": "nonterminals/loan_types.txt" },
    "amortization_period": { "type": "file", "path": "nonterminals/amortization_periods.txt" },
    "cash_amount": { "type": "file", "path": "nonterminals/cash_amounts.txt" },
    "currencies":  { "type": "inline", "values": ["USD", "EUR", "GBP"] }
  },
  "flags": {
    "allowed_types": ["string", "int", "float", "bool", "enum"],
    "reserved_keys": ["intent", "slot", "min_conf", "requires_auth", "log_level"],
    "allow_lhs": true
  },
  "functions": {
    "normalise": {
      "parameters": [
        { "name": "value", "type": "rule_ref" },
        { "name": "unit",  "type": "string"  }
      ],
      "return_type": "expansion",
      "doc": "Normalises numeric value to canonical form for the given unit."
    },
    "lookup": {
      "parameters": [
        { "name": "dict",   "type": "string" },
        { "name": "locale", "type": "string", "optional": true }
      ],
      "return_type": "expansion",
      "doc": "Dynamic vocabulary lookup from engine dictionary."
    },
    "extract": {
      "parameters": [
        { "name": "source",   "type": "rule_ref" },
        { "name": "type",     "type": "string"   },
        { "name": "min_conf", "type": "float",    "optional": true }
      ],
      "return_type": "slot",
      "doc": "Slot extraction with optional confidence threshold."
    }
  },
  "reserved_rules": ["VOID", "NULL", "GARBAGE"],
  "tag_extensions": {
    "allow_multiline": true,
    "value_interpolation": true
  }
}
